# Optional base URL of the backend API, used by src/api/client.ts.
# Local development defaults to the API started by backend/scripts/run_api.py.
# Uncomment and set this when the backend runs at a different address.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Production: point this at the deployed API Gateway HTTP API URL so the
# Amplify-hosted frontend talks to the Lambda backend. Set it in the Amplify
# console as an environment variable (VITE_API_BASE_URL) and redeploy:
#   https://<api-id>.execute-api.us-east-2.amazonaws.com
# The frontend itself is not modified; only this environment value changes.
