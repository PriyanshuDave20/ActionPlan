__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.python-version

# Local runtime data (never required in the Lambda image)
/data/
*.log

# Non-runtime project content
documents/
scripts/
tests/
frontend/
docs/
*.ps1
*.yml
*.yaml
README.md
Dockerfile
docker-compose.yml